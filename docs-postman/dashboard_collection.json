		{
			"name": "3. Pagamentos (Pix e Webhook)",
			"description": "Fluxo de pagamento. O primeiro endpoint é privado (requer token) e o segundo é público (para o Mercado Pago).",
			"item": [
				{
					"name": "POST Criar Pagamento Pix (Gerar QR Code)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"transactionAmount\": 1.50,\n    \"description\": \"Teste Upgrade Plano R$1.50\",\n    \"email\": \"seu.email.real@gmail.com\",\n    \"identificationType\": \"CPF\",\n    \"identificationNumber\": \"SEU_CPF_REAL_AQUI\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
