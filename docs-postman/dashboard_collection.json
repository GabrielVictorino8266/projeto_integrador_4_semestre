							],
							"path": [
								"api",
								"pagamentos",
								"pix"
							]
						},
						"description": "Endpoint privado (requer token) que o frontend chama para iniciar o upgrade. \n\n**IMPORTANTE:** Como este é um teste de produção (Heroku), use seu **CPF e E-mail reais** no Body para o pagamento de R$ 1,50 funcionar."
					},
					"response": []
				},
				{
					"name": "[WEBHOOK] POST Confirmar Pagamento (MP)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"payment\",\n    \"data\": {\n        \"id\": \"123456789\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/public/webhooks/mercadopago",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"public",
								"webhooks",
								"mercadopago"
							]
						},
						"description": "Endpoint PÚBLICO que o Mercado Pago chama (via ngrok em teste, ou Heroku em produção).\nDispara a lógica no `PagamentoService` para consultar o status do pagamento e atualizar o `TipoPlano` da `Empresa` para `PAGO`."
					},
					"response": []
				}
			]
		},
