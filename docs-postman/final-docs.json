	"item": [
		{
			"name": "1. Autenticação",
			"description": "Obtenha o Token JWT. Salva automaticamente na variável de ambiente `jwt_token`.",
			"item": [
				{
					"name": "POST Authenticate (Admin Cliente)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const token = pm.response.text();",
									"if (token) {",
									"    pm.environment.set(\"jwt_token\", token);",
									"    console.log(\"Token JWT (Admin Cliente) salvo!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "admin123"
								},
								{
									"key": "username",
									"value": "12345678901"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authenticate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"authenticate"
							]
						},
						"description": "Usa as credenciais do DataLoader: joao.silva@rapida.com.br (CPF: 12345678901), Senha: admin123"
					},
					"response": []
				},
				{
					"name": "POST Authenticate (Super Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const token = pm.response.text();",
									"if (token) {",
									"    pm.environment.set(\"jwt_token\", token);",
									"    console.log(\"Token JWT (Super Admin) salvo!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "superadmin123"
								},
								{
									"key": "username",
									"value": "00000000000"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authenticate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"authenticate"
							]
						},
						"description": "Usa as credenciais do DataLoader: superadmin@sistema.com (CPF: 00000000000), Senha: superadmin123"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Registro Público",
			"description": "Endpoint público para auto-registro de novos clientes. Cria a Empresa (como GRATUITO) e o primeiro Admin.",
			"item": [
				{
					"name": "POST Registrar Novo Cliente",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"razaoSocial\": \"Empresa Auto Registro LTDA\",\n    \"nomeFantasia\": \"Auto Registro Transp\",\n    \"cnpj\": \"77889900000144\",\n    \"adminNome\": \"Admin Auto Registrado\",\n    \"adminSenha\": \"senhaAutoRegistro123\",\n    \"adminCpf\": \"44455566677\",\n    \"adminEmail\": \"admin@autoregistro.com\",\n    \"adminDataNascimento\": \"1992-02-02\",\n    \"adminTelefone\": \"11944443333\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/public/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"public",
								"register"
							]
						},
						"description": "Endpoint público para um novo cliente se registrar. Cria a empresa (com plano GRATUITO) e o primeiro usuário admin."
					},
					"response": []
				}
			],
			"auth": {
				"type": "noauth"
			}
		},
		{
			"name": "3. Pagamentos (Pix e Webhook)",
			"description": "Fluxo de pagamento. O primeiro endpoint é privado (requer token) e o segundo é público (para o Mercado Pago).",
			"item": [
				{
					"name": "POST Criar Pagamento Pix (Gerar QR Code)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"transactionAmount\": 149.90,\n    \"description\": \"Upgrade Plano PRO\",\n    \"email\": \"cliente@empresa.com\",\n    \"identificationType\": \"CPF\",\n    \"identificationNumber\": \"12345678901\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/pagamentos/pix",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"pagamentos",
								"pix"
							]
						},
						"description": "Endpoint privado (requer token) que o frontend chama para iniciar o upgrade. \n1. Cria um `PedidoPagamento` local como PENDENTE.\n2. Chama o Mercado Pago.\n3. Retorna o `qrCodeBase64` e o `qrCode` para o frontend."
					},
					"response": []
				},
				{
					"name": "[WEBHOOK] POST Confirmar Pagamento (MP)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"payment\",\n    \"data\": {\n        \"id\": \"123456789\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/public/webhooks/mercadopago",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"public",
								"webhooks",
								"mercadopago"
							]
						},
						"description": "Endpoint PÚBLICO que o Mercado Pago chama (via ngrok em teste).\nDispara a lógica no `PagamentoService` para consultar o status do pagamento e atualizar o `TipoPlano` da `Empresa` para `PAGO`."
					},
					"response": []
				}
			]
		},
		{
