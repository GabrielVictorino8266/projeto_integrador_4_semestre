{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-1234567890ab",
		"name": "Projeto Integrador 4 Semestre - API Completa",
		"description": "Coleção unificada contendo todos os endpoints do projeto, incluindo autenticação, gerenciamento e pagamentos.",
